// ═══════════════════════════════════════════════════════════════
//  PROMO TEMPORAL — Día del Padre · Junio 2026
//  20 % de descuento en mensualidades de Pesas y Spinning
//  Precios base: Pesas $380 / Spinning $500
//  Precios promo: Pesas $304 ($380 × 0.80) / Spinning $400 ($500 × 0.80)
//  Solo para papás con identificación oficial · Válido 1–30 junio 2026
// ═══════════════════════════════════════════════════════════════
const promosJunio = [
  {
    id: 1,
    servicio: "Fuerza y Pesas",
    subtitulo: "Área completa con asesoría",
    precioOriginal: "$380",
    precioPromo: "$300", // $380 × 0.80
    ahorro: "$76", // $380 × 0.20
    icon: "🏋️",
    imagen: "/bento-info/bentopesas.webp",
    highlight: false,
    features: [
      "Entrenadores de pisos",
      "Acceso completo al área",
      "Lun–Vie 5am–10pm",
      "Sáb 5am–5pm",
      "Dom 12pm–4pm",
    ],
  },
  {
    id: 2,
    servicio: "Clases de Spinning",
    subtitulo: "Instructor certificado incluido",
    precioOriginal: "$500",
    precioPromo: "$400", // $500 × 0.80
    ahorro: "$100", // $500 × 0.20
    icon: "🚴‍♂️",
    imagen: "/bento-info/bentospining.webp",
    highlight: true,
    features: [
      "Cupo limitado garantizado",
      "Lun–Vie 6am–7am / 7am–8am",
      "Lun–Vie 6pm–7pm / 7pm–8pm",
      "Instructor certificado",
      "Técnica y postura incluidas",
    ],
  },
];

// ═══════════════════════════════════════════════════════════════
//  CONDICIONES — Datos para el banner informativo
// ═══════════════════════════════════════════════════════════════
const condiciones = [
  {
    emoji: "📋",
    texto: "Muestra una",
    destacado: "foto con tu hij@",
  },
  {
    emoji: "📅",
    texto: "Válido del",
    destacado: "1 al 30 de junio",
  },
  {
    emoji: "👨‍💪",
    texto: "Solo para",
    destacado: "papás",
  },
];

// ═══════════════════════════════════════════════════════════════
//  PASOS — Cómo canjear el descuento de Día del Padre
// ═══════════════════════════════════════════════════════════════
const pasos = [
  {
    numero: 1,
    titulo: "Visítanos o escríbenos",
    descripcion:
      "Acércate al gym o contáctanos por redes sociales durante junio. Te atendemos con gusto.",
  },
  {
    numero: 2,
    titulo: "Acredita que eres papá",
    descripcion:
      "Muéstranos una foto tuya con tu hijo o hija y listo — con eso aplicamos el descuento.",
  },
  {
    numero: 3,
    titulo: "Activa tu 20 % off",
    descripcion:
      "El descuento se aplica directo en tu mensualidad de Pesas o Spinning. ¡Así de fácil, papá!",
  },
];

// ═══════════════════════════════════════════════════════════════
//  PROMOCIONES PERMANENTES — Sin fecha límite
// ═══════════════════════════════════════════════════════════════
const promosPermanentes = [
  {
    id: 1,
    icon: "🎁",
    titulo: "Inscripción Gratis",
    descripcion:
      "Sin costo de inscripción todo el año para cualquier plan. Sin letra pequeña, solo pagas tu mensualidad.",
    badge: "Todo el Año",
    detalle: "¡Ahorras $200!",
  },
  {
    id: 2,
    icon: "🎂",
    titulo: "Cumpleaños 10 % Off",
    descripcion:
      "Descuento del 10 % en tu mensualidad durante todo tu mes de cumpleaños. Presenta identificación oficial y disfruta.",
    badge: "Especial",
    detalle: "Cada año, tu mes",
  },
];

// ═══════════════════════════════════════════════════════════════
//  FAQ — Preguntas frecuentes sobre la promo de Día del Padre
// ═══════════════════════════════════════════════════════════════
const faqItems = [
  {
    question: "¿Sigue disponible la promo de Día del Padre?",
    answer:
      "No. Fue exclusiva para papás durante junio de 2026 y ya finalizó el 30 de junio. Los precios especiales de esa promo ya no aplican.",
  },
  {
    question: "¿Puedo pedir el precio de la promo aunque ya haya terminado?",
    answer:
      "No, el precio con 20 % de descuento solo aplicó a inscripciones y renovaciones realizadas dentro de junio de 2026. Consulta nuestros precios vigentes en la sección de Servicios.",
  },
  {
    question: "¿Hay alguna promoción activa ahora mismo?",
    answer:
      "La inscripción gratis está disponible todo el año, y el 10 % de descuento de cumpleaños aplica durante tu mes de cumpleaños. Revisa esta página o nuestras redes para futuras promociones temporales.",
  },
  {
    question: "¿Cuándo estuvo vigente la promo de Día del Padre?",
    answer:
      "Estuvo disponible del 1 al 30 de junio de 2026. Fuera de ese período, incluido ahora, no se aplica el precio especial.",
  },
  {
    question: "¿Qué incluye la mensualidad de Pesas?",
    answer:
      "Incluye acceso completo al área de fuerza y pesas, entrenadores de pisos y horarios Lun–Vie 5am–10pm, Sáb 5am–5pm, Dom 12pm–4pm.",
  },
  {
    question: "¿Qué incluye la mensualidad de Spinning?",
    answer:
      "Incluye acceso a todas las clases de Spinning con instructor certificado, en los horarios Lun–Vie 6am–7am, 7am–8am, 6pm–7pm y 7pm–8pm. Cupo limitado.",
  },
];

// ═══════════════════════════════════════════════════════════════
//  NAVEGACIÓN MÓVIL INFERIOR
// ═══════════════════════════════════════════════════════════════
const mobileNavItems = [
  {
    id: "planes-papa",
    label: "Planes",
    href: "#planes-papa",
    icon: "clock" as const,
  },
  {
    id: "permanentes",
    label: "Siempre",
    href: "#promociones-permanentes",
    icon: "tag" as const,
  },
  { id: "faq", label: "FAQ", href: "#faq", icon: "grid" as const },
  {
    id: "inscribirse",
    label: "Inscríbete",
    href: "/contacto",
    icon: "star" as const,
  },
];
---

<Layout
  title="Promociones | Gym Trasciende — Promo Día del Padre finalizada"
  description="La promo de Día del Padre (20% de descuento en Pesas y Spinning) fue exclusiva de junio 2026 y ya finalizó. Consulta los precios vigentes de Gym Trasciende Ocotlán."
  keywords="promociones gym ocotlán, precios gym trasciende, mensualidad gym ocotlán"
  type="website"
>
  {
    /* ═══════════════════════════════════════════════════════
      SECCIÓN 1 — HERO
      Fondo: /imagenfondo5.webp con overlays oscuros
      Decorativo: "20%" gigante en el fondo (muy translúcido)
      Contenido: badge dorado, título + slogan, precios rápidos, CTAs
      ═══════════════════════════════════════════════════════ */
  }
  <section
    class="bg-background relative min-h-screen overflow-hidden"
    aria-label="Promo Día del Padre Junio 2026"
  >
    {/* Imagen de fondo del gym */}
    <img
      src="/hero-2.webp"
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-center"
      loading="eager"
      aria-hidden="true"
    />

    {/* Mobile: overlay sólido oscuro desde abajo */}
    <div
      class="from-background/97 via-background/85 to-background/40 absolute inset-0 bg-linear-to-t lg:hidden"
    >
    </div>

    {/* Desktop: gradiente de izquierda (oscuro) a derecha (transparente) */}
    <div
      class="from-background via-background/90 absolute inset-0 hidden bg-linear-to-r to-transparent lg:block"
    >
    </div>

    {/* Fade inferior suave en ambos breakpoints */}
    <div
      class="from-background absolute inset-x-0 bottom-0 h-48 bg-linear-to-t to-transparent"
    >
    </div>

    {
      /* Decorativo: "20%" enorme de fondo — refuerza visualmente el descuento */
    }
    <div
      class="pointer-events-none absolute inset-0 flex items-center justify-end overflow-hidden pr-4 opacity-[0.035] select-none lg:pr-12"
      aria-hidden="true"
    >
      <span
        class="text-primary leading-none font-black"
        style="font-size: clamp(12rem, 32vw, 26rem);"
      >
        20%
      </span>
    </div>

    {/* Contenido centrado verticalmente */}
    <div class="relative z-10 flex min-h-screen items-center">
      <div class="mx-auto w-full max-w-7xl px-4 py-28 lg:pt-36 lg:pb-16">
        <div class="flex max-w-2xl flex-col gap-7">
          {/* Aviso — la promo ya terminó, debe ser lo primero que se vea */}
          <div
            class="inline-flex w-fit items-center gap-2.5 rounded-xl border-2 border-red-500/70 bg-red-950/90 px-4 py-2.5 shadow-lg backdrop-blur-sm"
          >
            <span class="text-lg" aria-hidden="true">⛔</span>
            <p class="text-sm font-bold text-red-100">
              Promoción finalizada — fue válida del 1 al 30 de junio de 2026
            </p>
          </div>

          {/* Badge dorado — evoca el Día del Padre (promo ya pasada) */}
          <div class="inline-flex items-center gap-3">
            <div class="h-px w-10 bg-zinc-500"></div>
            <span
              class="rounded-full border border-zinc-600 bg-zinc-800/60 px-4 py-1.5 text-xs font-semibold tracking-widest text-zinc-400 uppercase"
            >
              Día del Padre · Junio 2026 (finalizada)
            </span>
          </div>

          {/* Título principal */}
          <h1
            class="text-5xl leading-[1.05] font-black tracking-tight text-white md:text-7xl lg:text-8xl"
          >
            Papá este mes
            <span
              class="from-primary to-primary/60 block bg-linear-to-r bg-clip-text text-transparent"
            >
              te toca a ti.
            </span>
          </h1>

          {/* Subtítulo */}
          <p class="max-w-xl text-lg leading-relaxed text-zinc-300 md:text-xl">
            <span class="text-primary font-bold">20 % de descuento</span> en mensualidades
            de{" "}
            <span class="font-semibold text-white">Pesas</span> y{" "}
            <span class="font-semibold text-white">Spinning</span>. Solo durante
            junio, solo para papás.
          </p>

          {/* Precios de la promo — ya no vigentes, se muestran atenuados y tachados */}
          <div class="flex flex-wrap gap-3 opacity-60">
            {/* Precio Pesas */}
            <div
              class="rounded-xl border border-zinc-700 bg-zinc-900/70 px-4 py-3 backdrop-blur-sm"
            >
              <p
                class="text-xs font-medium tracking-wider text-zinc-500 uppercase"
              >
                Pesas
              </p>
              <div class="mt-1 flex items-baseline gap-2">
                <span class="text-xl font-black text-zinc-500 line-through"
                  >$304</span
                >
              </div>
            </div>

            {/* Precio Spinning */}
            <div
              class="rounded-xl border border-zinc-700 bg-zinc-900/70 px-4 py-3 backdrop-blur-sm"
            >
              <p
                class="text-xs font-medium tracking-wider text-zinc-500 uppercase"
              >
                Spinning
              </p>
              <div class="mt-1 flex items-baseline gap-2">
                <span class="text-xl font-black text-zinc-500 line-through"
                  >$400</span
                >
              </div>
            </div>
          </div>
          <p class="-mt-4 text-xs font-semibold text-red-300">
            Estos precios ya no están disponibles.
          </p>

          {/* CTAs */}
          <div class="flex flex-col gap-4 pt-2 sm:flex-row">
            {/* CTA principal — baja al detalle de la promo finalizada */}
            <a
              href="#planes-papa"
              class="group border-primary text-primary hover:bg-primary/20 inline-flex items-center justify-center gap-2 rounded-xl border-2 px-6 py-3.5 font-bold transition-all duration-300 hover:scale-105 active:scale-95"
            >
              <span class="text-base font-semibold">Ver detalle</span>
              <ButtonAnimation
                width={22}
                height={22}
                class="transition-transform group-hover:scale-110"
              />
            </a>

            {/* CTA secundario — ir a precios vigentes */}
            <a
              href="/servicios"
              class="group border-secondary text-secondary hover:bg-secondary/10 inline-flex items-center justify-center gap-2 rounded-xl border-2 px-6 py-3.5 font-bold transition-all duration-300 hover:scale-105 active:scale-95"
            >
              <span class="text-base font-semibold">Ver precios actuales</span>
              <ArrowAnimation class="size-5" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    /* ═══════════════════════════════════════════════════════
      BANNER — Condiciones de la promo
      Tres píldoras: documentos requeridos, fechas, quién aplica
      ═══════════════════════════════════════════════════════ */
  }
  <div class="border-primary/10 border-y bg-zinc-950/90 backdrop-blur-sm">
    <div class="mx-auto max-w-5xl px-4 py-5">
      <div
        class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center sm:gap-8 md:gap-14"
      >
        {
          condiciones.map((c, i) => (
            <>
              {/* Píldora de condición */}
              <div class="flex items-center gap-2.5">
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-amber-400/10">
                  <span class="text-sm">{c.emoji}</span>
                </div>
                <p class="text-sm text-zinc-400">
                  {c.texto}{" "}
                  <span class="font-semibold text-white">{c.destacado}</span>
                </p>
              </div>

              {/* Separador vertical entre píldoras (solo desktop, no después del último) */}
              {i < condiciones.length - 1 && (
                <div class="hidden h-5 w-px bg-zinc-700 sm:block" />
              )}
            </>
          ))
        }
      </div>
    </div>
  </div>

  {
    /* ═══════════════════════════════════════════════════════
      SECCIÓN 2 — VIDEO DE LA PROMO
      Mismo layout que SocialBest: px-0 + flex con overflow-hidden
      para que el video se vea igual que en el carrusel del home
      ═══════════════════════════════════════════════════════ */
  }
  <SectionContainer class="px-0 py-14 md:py-20">
    {/* Título de la sección */}
    <div class="mb-8 flex items-center justify-center gap-3 px-4">
      <div class="h-px w-8 bg-amber-400/60"></div>
      <span
        class="text-xs font-semibold tracking-widest text-amber-400 uppercase"
      >
        Mira cómo funciona
      </span>
      <div class="h-px w-8 bg-amber-400/60"></div>
    </div>

    <div
      class="-mr-4 flex snap-x snap-mandatory justify-center overflow-hidden pr-4 md:mr-0 md:pr-0"
    >
      <TiktokVideo
        videoId="7649840305780313361"
        thumbnailUrl="/img/thumbnails/tpapa.webp"
        title="Promo Día del Padre — 20% de descuento en Pesas y Spinning"
      />
    </div>
  </SectionContainer>

  {
    /* ═══════════════════════════════════════════════════════
      SECCIÓN 3 — EVENTO ESPECIAL: EL BOTE CHALLENGE
      Componente autocontenido — eliminar línea de abajo para quitar el evento
      ═══════════════════════════════════════════════════════ */
  }
  <PromoEventoBote />

  {
    /* ═══════════════════════════════════════════════════════
      SECCIÓN 4 — PLANES CON 20 % OFF
      Tarjetas con imagen de cabecera, precios comparados,
      lista de beneficios y CTA individual por plan
      ═══════════════════════════════════════════════════════ */
  }
  <SectionContainer class="py-20 md:py-28">
    <div id="planes-papa" class="mx-auto max-w-7xl">
      {/* Encabezado de sección */}
      <div class="mb-14 text-center">
        <span
          class="mb-4 inline-block rounded-full border border-red-500/40 bg-red-950/60 px-4 py-1 text-xs font-semibold tracking-widest text-red-300 uppercase"
        >
          Promo Finalizada
        </span>
        <h2 class="text-3xl font-black text-white md:text-5xl">
          Esta Promo con{" "}
          <span class="text-zinc-500 line-through">20 % Off</span> Ya Terminó
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-zinc-400">
          Estos precios especiales fueron exclusivos de junio 2026 y ya no
          están disponibles. Consulta nuestros precios vigentes en{" "}
          <a href="/servicios" class="text-primary underline"
            >Servicios</a
          >.
        </p>
      </div>

      {/* Aviso de cierre — reemplaza al countdown, que ya llegó a cero */}
      <div class="mb-12 flex justify-center">
        <div
          class="rounded-2xl border border-red-500/30 bg-zinc-900/60 px-8 py-5 text-center backdrop-blur-sm"
        >
          <p
            class="mb-1 text-xs font-semibold tracking-widest text-red-300 uppercase"
          >
            ⛔ Promoción cerrada
          </p>
          <p class="text-sm text-zinc-400">
            Finalizó el 30 de junio de 2026. Ya no se aceptan inscripciones ni
            renovaciones con este precio.
          </p>
        </div>
      </div>

      {/* Tarjetas de plan */}
      <div class="mx-auto grid max-w-4xl gap-6 md:grid-cols-2">
        {
          promosJunio.map((plan) => (
            <article class="group relative flex flex-col overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900/60 opacity-70 backdrop-blur-sm grayscale">
              {/* Imagen del área del gym con overlay degradado */}
              <div class="relative h-44 w-full overflow-hidden">
                <img
                  src={plan.imagen}
                  alt={plan.servicio}
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
                {/* Degradado que funde la imagen con el cuerpo de la tarjeta */}
                <div class="absolute inset-0 bg-linear-to-t from-zinc-900 via-zinc-900/30 to-transparent" />

                {/* Badge "PROMO FINALIZADA" fijo sobre la imagen */}
                <div class="absolute top-4 right-4 z-10">
                  <span class="rounded-full bg-red-600 px-3 py-1.5 text-xs font-black tracking-widest text-white uppercase shadow-lg">
                    Promo finalizada
                  </span>
                </div>

                {/* Icono del servicio en la esquina inferior izquierda */}
                <div class="absolute bottom-3 left-5 z-10">
                  <span class="text-2xl drop-shadow-lg">{plan.icon}</span>
                </div>
              </div>

              {/* Cuerpo de la tarjeta */}
              <div class="flex flex-1 flex-col p-7">
                {/* Nombre y subtítulo del servicio */}
                <h3 class="mb-1 text-2xl font-black text-white">
                  {plan.servicio}
                </h3>
                <p class="mb-5 text-sm font-semibold text-zinc-500">
                  {plan.subtitulo}
                </p>

                {/* Precio tachado — ya no vigente */}
                <div class="mb-1 flex items-baseline gap-3">
                  <span class="text-4xl font-black text-zinc-500 line-through tabular-nums">
                    {plan.precioPromo}
                  </span>
                </div>
                <p class="mb-6 text-sm font-semibold text-red-300">
                  Este precio especial ya no está disponible.
                </p>

                {/* Separador punteado */}
                <div class="mb-6 border-t border-dashed border-zinc-700" />

                {/* CTA de la tarjeta — redirige a precios vigentes */}
                <a
                  href="/servicios"
